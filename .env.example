# ── Airtable ──────────────────────────────────────────────────────────────────
# Personal Access Token from https://airtable.com/create/tokens
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX

# Found in your Airtable base URL: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your Twilio outbound number in E.164 format
TWILIO_FROM_NUMBER=+18135550123

# ── App config ────────────────────────────────────────────────────────────────
PORT=5000

# Timezone for callback time display in SMS (pytz/IANA format)
# Options: America/New_York | America/Chicago | America/Denver | America/Los_Angeles
LOCAL_TIMEZONE=America/New_York
